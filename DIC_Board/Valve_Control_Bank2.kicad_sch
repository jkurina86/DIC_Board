	)
	(text "FIRMWARE: serialize valve commands; apply a bounded set/reset polarity pulse (public family minimum 500 ms); never energize continuously."
		(exclude_from_sim no)
		(at 25.4 33.655 0)
		(effects
			(font
				(size 0.9 0.9)
			)
