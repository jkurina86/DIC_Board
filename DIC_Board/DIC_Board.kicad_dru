(version 1)

# Preliminary layout rules. The absolute board minimum is 0.15 mm;
# the general rule below requires 0.25 mm except for the specific P1 case.
(rule "General copper to hole clearance"
  (constraint hole_clearance (min 0.25mm)))

# The existing GCT USB4105 footprint has 0.1944 mm between its locating
# holes and ground pads. Limit this local 0.15 mm allowance to P1 itself.
(rule "USB connector internal locating-hole clearance"
  (condition "A.memberOfFootprint('P1') && B.memberOfFootprint('P1')")
  (constraint hole_clearance (min 0.15mm)))

# This preliminary stack assumes mechanically drilled through vias.
(rule "Through vias only"
  (constraint disallow micro_via blind_buried_via))
